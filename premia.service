[Unit]
Description=Premia FastAPI Application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/opt/BonusPayments
Environment="PATH=/opt/BonusPayments/venv/bin"
ExecStart=/opt/BonusPayments/venv/bin/gunicorn -k uvicorn.workers.UvicornWorker main:app --bind 127.0.0.1:8000
Restart=always

[Install]
WantedBy=multi-user.target